alias gs='git status '
alias ga='git add '
alias gb='git branch '
alias gc='git commit'
alias gd='git diff'
alias gco='git checkout '

if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
  alias bat='batcat'
fi
alias apt-update='sudo apt update && sudo apt upgrade && sudo apt autoclean && sudo apt autoremove'
alias popos-dock-transparent='gsettings set org.gnome.shell.extensions.dash-to-dock background-opacity 0.4'

alias docker-start='sudo systemctl start docker'
alias docker-stop='sudo systemctl stop docker'

alias lzd='lazydocker'
alias lzg='lazygit'

alias bootwin='sudo efibootmgr -n 5 && sudo reboot'
alias bootbios='sudo systemctl reboot --firmware-setup'

alias docker-compose='docker compose'

alias py='python3'

alias supa=~/dotfiles/tmux/supa.sh
